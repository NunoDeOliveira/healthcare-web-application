param sites_medicore_backend_name string = 'medicore-backend'
param appServicePlanName string = 'asp-medicore-app'
param location string = 'spaincentral'
param networkResourceGroupName string = 'rg-medicore-net'
param vnetName string = 'medicore-vnet'
param integrationSubnetName string = 'app-int-subnet'

// App Service Plan in the deployment resource group.
resource appServicePlan 'Microsoft.Web/serverfarms@2024-11-01' existing = {
  name: appServicePlanName
}

// VNet is in a different resource group.
resource vnet 'Microsoft.Network/virtualNetworks@2025-09-01' existing = {
  name: vnetName
  scope: resourceGroup(networkResourceGroupName)
}

resource sites_medicore_backend_name_resource 'Microsoft.Web/sites@2024-11-01' = {
  name: sites_medicore_backend_name
  location: location
  kind: 'app,linux'
  properties: {
    enabled: true
    serverFarmId: appServicePlan.id
    reserved: true
    outboundVnetRouting: {
      allTraffic: false
      applicationTraffic: true
      contentShareTraffic: false
      imagePullTraffic: false
      backupRestoreTraffic: false
    }
    scmSiteAlsoStopped: false
    clientAffinityEnabled: false
    clientAffinityProxyEnabled: false
    clientCertEnabled: false
    hostNamesDisabled: false
    ipMode: 'IPv4'
    httpsOnly: true
    endToEndEncryptionEnabled: false
    redundancyMode: 'None'
    publicNetworkAccess: 'Enabled'
    storageAccountRequired: false
    virtualNetworkSubnetId: '${vnet.id}/subnets/${integrationSubnetName}'
    keyVaultReferenceIdentity: 'SystemAssigned'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
  }
}

// Preserve the exported publishing policies for this first what-if comparison.
// Basic authentication should be disabled after OIDC deployment is configured.
resource sites_medicore_backend_name_ftp 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: sites_medicore_backend_name_resource
  name: 'ftp'
  properties: {
    allow: true
  }
}

resource sites_medicore_backend_name_scm 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: sites_medicore_backend_name_resource
  name: 'scm'
  properties: {
    allow: true
  }
}

resource sites_medicore_backend_name_web 'Microsoft.Web/sites/config@2024-11-01' = {
  parent: sites_medicore_backend_name_resource
  name: 'web'
  properties: {
    numberOfWorkers: 1
    linuxFxVersion: 'PYTHON|3.15'
    requestTracingEnabled: false
    remoteDebuggingEnabled: false
    httpLoggingEnabled: false
    acrUseManagedIdentityCreds: false
    logsDirectorySizeLimit: 35
    detailedErrorLoggingEnabled: false
    scmType: 'GitHubAction'
    webSocketsEnabled: false
    alwaysOn: false
    virtualApplications: [
      {
        virtualPath: '/'
        physicalPath: 'site\\wwwroot'
        preloadEnabled: false
      }
    ]
    loadBalancing: 'LeastRequests'
    autoHealEnabled: false
    ipSecurityRestrictions: [
      {
        ipAddress: 'Any'
        action: 'Allow'
        priority: 2147483647
        name: 'Allow all'
        description: 'Allow all access'
      }
    ]
    scmIpSecurityRestrictions: [
      {
        ipAddress: 'Any'
        action: 'Allow'
        priority: 2147483647
        name: 'Allow all'
        description: 'Allow all access'
      }
    ]
    scmIpSecurityRestrictionsUseMain: false
    http20Enabled: false
    minTlsVersion: '1.2'
    scmMinTlsVersion: '1.2'
    ftpsState: 'FtpsOnly'
  }
}
